NODE_ENV=production
DATABASE_URL=file:/var/data/dev.db
SITE_URL=https://your-app.onrender.com

# Stripe
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
